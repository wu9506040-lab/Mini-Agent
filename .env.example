# 复制为 .env 后填入真实值。所有配置一律环境变量注入，代码仓库零密钥。
# 兼容任意 OpenAI-compatible 端点；默认给出 MiniMax 订阅（Coding Plan）配置
# ⚠️ 订阅专用 Key 与按量计费 Key 不通用

LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=在这里粘贴你的MiniMax订阅Key
LLM_MODEL=MiniMax-M3
# 可选模型：MiniMax-M3 / MiniMax-M2.5 / MiniMax-M2.5-highspeed / MiniMax-M2.1 / MiniMax-M2
# 国际版端点：https://api.minimax.io/v1
# 其它端点示例：DeepSeek https://api.deepseek.com/v1 ；GLM https://open.bigmodel.cn/api/paas/v4

# Agent 行为参数（可选，有默认值）
MAX_ROUNDS=8
MAX_HISTORY_MESSAGES=40
RECENT_KEEP=20
DB_PATH=data/agent.db
